# Public URL of the site (used for sitemap and social links)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase project (member login + lead storage). Until these are set the site
# runs in preview mode: the login gate accepts any email and stores nothing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: also POST every lead as JSON to this URL (CRM, Zapier, form bot...)
LEAD_WEBHOOK_URL=

# Set to "false" once real neighborhoods/listings replace the placeholders.
# This removes the preview ribbon and lets search engines index the site.
NEXT_PUBLIC_PREVIEW_DATA=true
